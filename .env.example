# ===========================================
# PROJECT CONFIGURATION
# ===========================================
PROJECT_NAME=my-project
NODE_ENV=development

# ===========================================
# DATABASE (PostgreSQL - Local by default)
# ===========================================
# Local PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://starter_user:local_dev_password@localhost:5433/starter_db

# For production, use your PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@host:5432/database

# ===========================================
# AUTHENTICATION (JWT)
# ===========================================
# IMPORTANT: Change this secret key in production!
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE
JWT_EXPIRE_MINUTES=60

# Webhook signature secret (used for HMAC-SHA256 verification)
WEBHOOK_SECRET=CHANGE_ME

# ===========================================
# AI MODELS (All Optional - Ollama used by default)
# ===========================================
# AI Provider: "ollama" (local) or "anthropic" (cloud)
AI_PROVIDER=ollama

# Ollama Configuration (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Anthropic (Claude) - Optional cloud provider
# ANTHROPIC_API_KEY=sk-ant-xxx

# ===========================================
# ANTHROPIC FEATURE FLAGS
# ===========================================
STREAMING_ENABLED=true
THINKING_ENABLED=false          # Adaptive thinking (Opus 4.6 / Sonnet 4.6 only)
THINKING_BUDGET_TOKENS=10000    # Thinking token budget
FAST_MODE_ENABLED=false         # 2.5x faster Opus 4.6 output (research preview)
WEB_SEARCH_ENABLED=false        # Web Search Tool v2 (requires Opus/Sonnet 4.6)
WEB_SEARCH_MAX_USES=5
TOKEN_COUNT_WARNING_THRESHOLD=50000
AGENT_SKILLS_ENABLED=false      # Excel/PowerPoint/Word/PDF processing (beta)
MCP_CONNECTOR_ENABLED=false     # Remote MCP server connections (Remote Control beta)

# VOICE_MODE: NOT available via Anthropic API.
# Voice is only available in the Claude.ai consumer app and Claude Code CLI.
# This note prevents confusion when referencing Anthropic platform feature lists.

# Google (Gemini) - Optional
# GOOGLE_AI_API_KEY=xxx

# OpenRouter (Multi-model access) - Optional
# OPENROUTER_API_KEY=sk-or-xxx

# ===========================================
# MCP TOOLS
# ===========================================
# Exa (Web Search)
EXA_API_KEY=xxx

# Ref.tools
REF_TOOLS_API_KEY=xxx

# ===========================================
# BACKEND
# ===========================================
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=your-internal-api-key

# CORS: comma-separated list of allowed origins (pydantic parses JSON arrays too)
# Production: set to your Vercel domain(s)
# CORS_ORIGINS=["https://your-app.vercel.app","https://your-app.com"]
CORS_ORIGINS=["http://localhost:3000"]

# ===========================================
# CRON JOBS
# ===========================================
# Secret for authenticating Vercel cron job requests
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=your-cron-secret-here

# ===========================================
# EMAIL (Resend)
# ===========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# Public-facing URL for email links (password reset, etc.)
APP_URL=http://localhost:3000

# ===========================================
# DEPLOYMENT ENVIRONMENT
# ===========================================
# Values: development | staging | production
# IMPORTANT: In production/staging, JWT_SECRET_KEY and WEBHOOK_SECRET
# must NOT be default placeholders or startup will fail.
ENVIRONMENT=development

# ===========================================
# FRONTEND
# ===========================================
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info

# ===========================================
# DEPLOYMENT (DigitalOcean)
# ===========================================
DO_APP_ID=your-app-id
DO_API_TOKEN=your-do-token
DIGITALOCEAN_API=your-do-token

# ===========================================
# JINA AI (Web Reading / Scraping)
# ===========================================
# Get from: https://jina.ai/
JINA_API_KEY=your-jina-api-key

# ===========================================
# STRIPE (Payments & Billing)
# ===========================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===========================================
# LINEAR (Project Management - MCP Server)
# ===========================================
# Get from: https://linear.app/YOUR-TEAM/settings/api
LINEAR_API_KEY=your-linear-api-key
